

class Solution:
    def findMedianSortedArrays(self, nums1: List[int], nums2: List[int]) -> float:
        combined = nums1 + nums2
        combined.sort()
        
        n = len(combined)

        if n % 2 == 1:
            return combined[n // 2]
        else:
            mid1 = combined[n // 2 - 1]
            mid2 = combined[n // 2]
            return (mid1 + mid2) / 2

s1 = Solution()
print(s1.findMedianSortedArrays([1, 3], [2]))
