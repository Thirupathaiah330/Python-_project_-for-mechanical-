class Solution:
    def minPathSum(self, grid: List[List[int]]) -> int:
        m = len(grid)   
        n = len(grid[0])
        db = [[0] * n for _ in range(m)]
        sum1 , sum2 = 0 , 0 
        for i in  range (max(m ,n )) :   
            if i < n  : 
                sum1 += grid[0][i] 
                db[0][i]  =  sum1 
            if i < m :  
                sum2 += grid [i][0] 
                db[i][0] =  sum2        
        for i in  range   (1 ,m):   
            for j in range (1,n) :    
                db[i][j] =  grid[i][j] +  min(db[i-1][j] , db[i][j-1])
        return db[len(grid) -1][len(grid[0])-1]
