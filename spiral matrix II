class Solution:
    def generateMatrix(self, n: int) -> List[List[int]]:
        x=[[0] * n for _ in range(n)]
        top=0
        left=0
        bot=n-1
        right=n-1
        num=1
        while top <= bot and left <= right:
            for i in range(left,right+1):
                x[top][i]=num
                num+=1
            top+=1
            for j in range(top,bot+1):
                x[j][right]=num
                num+=1
            right-=1
            for i in range(right,left-1,-1):
                x[bot][i]=num
                num+=1
            bot-=1
            for i in range(bot,top-1,-1):
                x[i][left]=num
                num+=1
            left+=1
        return (x)
