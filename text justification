from typing import List


class Solution:
    def fullJustify(self, words: List[str], maxWidth: int) -> List[str]:
        res = []
        arr = [words[0]]
        current = words[0]
        for i in range(1, len(words)):
            if len(current + " " + words[i]) > maxWidth:
                if len(arr) == 1:
                    arr.append("")
                spaces = maxWidth - len(current)
                pointer = 1
                while spaces > 0:
                    spaces -= 1
                    arr[pointer] += " "
                    pointer += 2
                    if pointer >= len(arr):
                        pointer = 1
                res.append("".join(arr))
                current = words[i]
                arr = [words[i]]
            else:
                arr.append(" ")
                arr.append(words[i])
                current += " " + words[i]

        res.append(current + " " * (maxWidth - len(current)))
        return res
