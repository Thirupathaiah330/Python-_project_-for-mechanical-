class Solution:
    def isInterleave(self, s1: str, s2: str, s3: str) -> bool:
        len_s1 = len(s1)
        len_s2 = len(s2)
        len_s3 = len(s3)

        if len_s1+len_s2 != len_s3:
            return False
        
        from functools import lru_cache
        @lru_cache(None)

        def dfs(i,j,k):
            for a in range(k,len_s3):
                if i<len_s1 and j<len_s2 and s1[i] == s2[j] and s2[j] == s3[a]:
                    return dfs(i+1,j,a+1) or dfs(i,j+1,a+1)
                elif i<len_s1 and s3[a]==s1[i]:
                    i += 1
                    a += 1
                elif j<len_s2 and s3[a]==s2[j]:
                    j += 1
                    a += 1
                else:
                    return False
            return True
            
        return dfs(0,0,0)
